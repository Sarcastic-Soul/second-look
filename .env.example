# Agentboxd: Settings > API keys
AGENTBOXD_API_KEY=
# Signing secret for the inbound webhook (Webhooks page)
AGENTBOXD_WEBHOOK_SECRET=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Used when the main model is overloaded (503) or times out
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Public URL of the app, used for report links in replies
APP_URL=

# Neon Postgres connection string (pooled)
DATABASE_URL=

# Google Safe Browsing API key
SAFE_BROWSING_API_KEY=

# Optional
# Inbox id for family emails (looked up by address when empty)
AGENTBOXD_INBOX_ID=
# Smallest scam confidence (0-1) that alerts a family contact
FAMILY_ALERT_MIN_CONFIDENCE=0.8
# Checks per hour per email sender / per web visitor
EMAIL_HOURLY_LIMIT=10
WEB_HOURLY_LIMIT=20
# 1 = log replies and family emails instead of sending them
DRY_RUN=
